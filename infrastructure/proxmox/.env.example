# Video AI Platform - Proxmox Environment Configuration
# Copy this file to .env and update with your production values

# PostgreSQL
POSTGRES_PASSWORD=change_me_secure_password_here

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_secure_minio_password

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_secure_keycloak_password

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_secure_grafana_password

# Application Settings
ENVIRONMENT=qualification
LOG_LEVEL=INFO
