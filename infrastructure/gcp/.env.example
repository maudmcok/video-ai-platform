# Video AI Platform - GCP Configuration
# Copy this file to .env and fill in your values

# ==============================================
# GCP PROJECT CONFIGURATION
# ==============================================
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# ==============================================
# GPU INSTANCE CONFIGURATION
# ==============================================
INSTANCE_NAME=videoai-gpu-worker
INSTANCE_TYPE=n1-standard-4  # 4 vCPUs, 15GB RAM
GPU_TYPE=nvidia-tesla-t4
GPU_COUNT=1

# Instance pricing model (preemptible or spot recommended for cost savings)
# Options: "standard", "preemptible", "spot"
PRICING_MODEL=spot

# ==============================================
# DOCKER IMAGE CONFIGURATION
# ==============================================
TRANSCRIPTION_IMAGE=gcr.io/${GCP_PROJECT_ID}/transcription-worker:cuda
DOCKER_REGISTRY=gcr.io

# ==============================================
# KAFKA CONFIGURATION (Proxmox connection)
# ==============================================
# Your Proxmox VM IP (will be connected via VPN)
KAFKA_BOOTSTRAP_SERVERS=192.168.1.23:9092

# ==============================================
# STORAGE CONFIGURATION
# ==============================================
MINIO_ENDPOINT=http://192.168.1.23:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=MinIO!Qualif2024#Storage456

# ==============================================
# MONITORING
# ==============================================
PROMETHEUS_ENDPOINT=http://192.168.1.23:9090

# ==============================================
# VPN CONFIGURATION (for secure Proxmox connection)
# ==============================================
# Your Proxmox public IP (if exposing via VPN)
PROXMOX_VPN_ENDPOINT=your-public-ip-or-domain

# WireGuard VPN keys (generate with: wg genkey)
WG_PRIVATE_KEY=generate_with_wg_genkey
WG_PUBLIC_KEY=generate_with_wg_pubkey

# ==============================================
# SCALING CONFIGURATION
# ==============================================
MIN_INSTANCES=0  # Scale to 0 when idle to save costs
MAX_INSTANCES=5  # Maximum concurrent GPU workers
TARGET_CPU_UTILIZATION=0.8  # 80%

# ==============================================
# BUDGET ALERTS
# ==============================================
MONTHLY_BUDGET=100  # USD - will alert if exceeded
ALERT_EMAIL=your-email@example.com

# ==============================================
# NOTES
# ==============================================
# ⚠️  This file contains sensitive information
# ⚠️  Copy to .env and fill with your actual values
# ⚠️  Never commit .env to Git
# ⚠️  Use GCP Secret Manager for production credentials
